<Window x:Class="WheelCompatibilityConfigurator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xbox Wheel Compatibility"
        Width="480" SizeToContent="Height" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Grid Margin="20,18,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Xbox Wheel Compatibility" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="SubtitleText" Text="Your racing wheel, as an Xbox controller" Foreground="{StaticResource SubtleTextBrush}" Margin="0,2,0,0" />
            </StackPanel>
            <Border x:Name="StatusPill" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="12" Padding="10,4,12,4" Background="#1AFFFFFF">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource SubtleTextBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock x:Name="StatusText" Text="Connecting..." FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main content: test panel, or the "service not running" card -->
        <Grid Grid.Row="1">

            <StackPanel x:Name="TestPanel">

                <!-- Steering -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Width="112" Height="112" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <RotateTransform x:Name="WheelRotation" Angle="0" />
                            </Grid.RenderTransform>
                            <Ellipse Stroke="{StaticResource TrackBrush}" StrokeThickness="11" />
                            <Path Stroke="{StaticResource TrackBrush}" StrokeThickness="9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 10,56 L 102,56 M 56,56 L 56,102" />
                            <Ellipse Width="34" Height="34" Fill="{StaticResource CardBrush}" Stroke="{StaticResource TrackBrush}" StrokeThickness="3" />
                            <Rectangle Width="7" Height="15" RadiusX="2" RadiusY="2" Fill="{StaticResource SteeringBrush}" VerticalAlignment="Top" Margin="0,-2,0,0" />
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="20,4,0,0" VerticalAlignment="Center">
                            <TextBlock Text="STEERING" Style="{StaticResource CardLabel}" />
                            <TextBlock x:Name="SteeringText" Text="Centered" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,12" />
                            <Grid x:Name="SteeringTrack" Height="10">
                                <Border Background="{StaticResource TrackBrush}" CornerRadius="5" />
                                <Border x:Name="SteeringFill" Background="{StaticResource SteeringBrush}" CornerRadius="5" HorizontalAlignment="Left" Width="0" />
                                <Rectangle Width="2" Fill="{StaticResource SubtleTextBrush}" HorizontalAlignment="Center" Margin="0,-3" />
                            </Grid>
                            <Grid Margin="0,4,0,0">
                                <TextBlock Text="Left" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" />
                                <TextBlock Text="Right" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Pedals + buttons -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="PEDALS" Style="{StaticResource CardLabel}" Margin="0,0,0,10" />
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Margin="0,0,18,0">
                                    <Border Width="26" Height="120" CornerRadius="6" Background="{StaticResource TrackBrush}" HorizontalAlignment="Center">
                                        <Border x:Name="BrakeFill" CornerRadius="6" Background="{StaticResource BrakeBrush}" VerticalAlignment="Bottom" Height="0" />
                                    </Border>
                                    <TextBlock x:Name="BrakeText" Text="0%" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                    <TextBlock Text="Brake" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" HorizontalAlignment="Center" />
                                    <TextBlock Text="LT" Foreground="{StaticResource SubtleTextBrush}" FontSize="10" HorizontalAlignment="Center" Opacity="0.7" />
                                </StackPanel>
                                <StackPanel>
                                    <Border Width="26" Height="120" CornerRadius="6" Background="{StaticResource TrackBrush}" HorizontalAlignment="Center">
                                        <Border x:Name="ThrottleFill" CornerRadius="6" Background="{StaticResource ThrottleBrush}" VerticalAlignment="Bottom" Height="0" />
                                    </Border>
                                    <TextBlock x:Name="ThrottleText" Text="0%" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                    <TextBlock Text="Throttle" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" HorizontalAlignment="Center" />
                                    <TextBlock Text="RT" Foreground="{StaticResource SubtleTextBrush}" FontSize="10" HorizontalAlignment="Center" Opacity="0.7" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="BUTTONS" Style="{StaticResource CardLabel}" Margin="0,0,0,10" />
                            <UniformGrid x:Name="ButtonGrid" Columns="4" />
                            <TextBlock x:Name="ExtraButtonsText" Text="Press any button on your wheel to test it."
                                       Foreground="{StaticResource SubtleTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="2,8,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Shown over the test panel when no wheel is plugged in -->
            <Border x:Name="NoWheelOverlay" Visibility="Collapsed" Background="#CC111318" CornerRadius="10">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                    <TextBlock Text="&#xE7FC;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="36" HorizontalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" />
                    <TextBlock Text="Plug in your wheel" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4" />
                    <TextBlock Text="Connect it by USB and make sure its power adapter is plugged in. It shows up here automatically."
                               Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300" />
                </StackPanel>
            </Border>

            <!-- Shown instead of everything when the background service can't be reached -->
            <Border x:Name="OfflinePanel" Visibility="Collapsed" Style="{StaticResource Card}" Padding="28,32">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="36" HorizontalAlignment="Center" Foreground="{StaticResource WarningBrush}" />
                    <TextBlock Text="Service not running" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4" />
                    <TextBlock Text="The background service sends your wheel to games. Without it, the wheel won't work."
                               Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320" />
                    <Button x:Name="StartServiceButton" Content="Start service" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,18,0,0" Click="StartServiceButton_Click" />
                    <TextBlock x:Name="OfflineHintText" Text="Windows will ask for permission. If that doesn't work, reinstall Xbox Wheel Compatibility."
                               Foreground="{StaticResource SubtleTextBrush}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="FooterTitle" Text="Sending to games" FontWeight="SemiBold" />
                <TextBlock x:Name="FooterText" Text="Games see your wheel as an Xbox controller." Foreground="{StaticResource SubtleTextBrush}" FontSize="12" TextWrapping="Wrap" MaxWidth="300" HorizontalAlignment="Left" />
            </StackPanel>
            <Button x:Name="ToggleButton" Content="Pause" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" VerticalAlignment="Center" IsEnabled="False" Click="ToggleButton_Click"
                    ToolTip="Pause for games that already support your wheel directly, so they don't get doubled input." />
        </Grid>
    </Grid>
</Window>
