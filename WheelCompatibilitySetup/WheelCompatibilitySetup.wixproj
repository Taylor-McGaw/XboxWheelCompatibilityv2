<Project Sdk="WixToolset.Sdk/4.0.5">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <SuppressPdbOutput Condition="'$(Configuration)' == 'Release'">True</SuppressPdbOutput>
  </PropertyGroup>
  <ItemGroup>
    <!-- Run "dotnet publish -c Release" on these two projects before building the installer (see README). -->
    <ProjectReference Include="..\WheelCompatibilityConfigurator\WheelCompatibilityConfigurator.csproj" />
    <ProjectReference Include="..\WheelCompatibilityService\WheelCompatibilityService.csproj" />
  </ItemGroup>
</Project>
